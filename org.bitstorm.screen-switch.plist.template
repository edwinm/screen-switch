<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. install-agent substitutes __APP_PATH__ and __HOME__ and writes the
  result to ~/Library/LaunchAgents/. Nothing here is machine-specific until then.
-->
<plist version="1.0">
<dict>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>org.bitstorm.screen-switch</string>
	</array>
	<!-- Restart on a crash or a signal, but stay dead on a clean exit(0).
	     That is what makes the menu's Quit work; see AGENTS.md. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>org.bitstorm.screen-switch</string>
	<key>ProgramArguments</key>
	<array>
		<string>__APP_PATH__</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/screen-switch.agent.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/screen-switch.agent.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
